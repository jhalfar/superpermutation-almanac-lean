import LowerBounds.PTables
import Cert.Cap0
import LowerBounds.PSearch
import Mathlib.Tactic

/-! The caps `T5899.Ptabs` as a table that the kernel reads fast (generated by gen_cap.py). -/

namespace SuperpermLowerBounds
namespace Cert

theorem capT_in : ∀ j, j < 6 → ∀ x, x < 85 - 6 * j → capT j x = PS.capF T5899.Ptabs j x := by
  decide +kernel

theorem capT_out (j x : Nat) (h : ¬ (j < 6 ∧ x < 85 - 6 * j)) : PS.capF T5899.Ptabs j x = 0 := by
  unfold PS.capF
  rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD]
  by_cases hj : j < 6
  · have hx : 85 - 6 * j ≤ x := by omega
    interval_cases j <;> simp only [T5899.Ptabs, List.getElem?_cons_zero, List.getElem?_cons_succ,
      Option.getD_some] <;> rw [List.getElem?_eq_none (by simp; omega)] <;> rfl
  · rw [List.getElem?_eq_none (l := T5899.Ptabs) (by simp [T5899.Ptabs]; omega)]
    rfl

theorem capT_eq : capT = PS.capF T5899.Ptabs := by
  funext j x
  by_cases h : j < 6 ∧ x < 85 - 6 * j
  · exact capT_in j h.1 x h.2
  · rw [capT_out j x h]
    unfold capT
    have e : (Nat.blt j 6 && Nat.blt x (85 - 6 * j)) = false := by
      cases h1 : Nat.blt j 6 <;> cases h2 : Nat.blt x (85 - 6 * j)
      all_goals first | rfl | exact absurd ⟨by simpa [Nat.blt_eq] using h1, by simpa [Nat.blt_eq] using h2⟩ h
    rw [e]
    rfl

end Cert
end SuperpermLowerBounds
