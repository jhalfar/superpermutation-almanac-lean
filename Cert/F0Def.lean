import Cert.ChildN
import Cert.OkN
import Cert.W
import Cert.RDefs
import Cert.R_F0

/-! The search of F0 for the kernel (generated by plan_k.py). -/

namespace SuperpermLowerBounds
namespace Cert
namespace F0

noncomputable section

abbrev cd := codeR rl 1 134 85
abbrev mk := maskR rl 1 134 85
abbrev ct := cutR rl 1 134 85
abbrev fN := KS.potN 20 31 5
abbrev fS := KS.potS 20 31 5
/-- The search below a prefix. -/
abbrev G := goC cd mk fN fS ct wrecT true
/-- The same with natural potentials, on a prefix (what the kernel evaluates). -/
abbrev GS (s : CS) (L : List CS) : Res := goN cd mk rl 1 134 85 20 31 5 wrecT true s.f s.t s.r s.d s.m s.M s.q s.B L
abbrev SN := searchN cd mk rl 1 134 85 20 31 5 wrecT true
/-- What an evaluated lemma states (the potential bounds and the search). -/
abbrev OK := okN rl 1 134 85 20 31 5 wrecT true
/-- `k` rows more along the path `p`. -/
abbrev chd (k : Nat) (s : CS) (p : Nat) : CS := childOf 20 31 5 wrecT k s p
/-- The prefix with the path `p` of `k` rows from the start. -/
abbrev pth (k p : Nat) : CS := pathCS 20 31 5 wrecT wsT 400 k p

end

end F0
end Cert
end SuperpermLowerBounds
