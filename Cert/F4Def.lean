import Cert.ChildN
import Cert.OkN
import Cert.W
import Cert.RDefs
import Cert.R_F4

/-! The search of F4 for the kernel (generated by plan_k.py). -/

namespace SuperpermLowerBounds
namespace Cert
namespace F4

noncomputable section

abbrev cd := codeR rl 5 130 61
abbrev mk := maskR rl 5 130 61
abbrev ct := cutR rl 5 130 61
abbrev fN := KS.potN 10 16 30
abbrev fS := KS.potS 10 16 30
/-- The search below a prefix. -/
abbrev G := goC cd mk fN fS ct wrecT true
/-- The same with natural potentials, on a prefix (what the kernel evaluates). -/
abbrev GS (s : CS) (L : List CS) : Res := goN cd mk rl 5 130 61 10 16 30 wrecT true s.f s.t s.r s.d s.m s.M s.q s.B L
abbrev SN := searchN cd mk rl 5 130 61 10 16 30 wrecT true
/-- What an evaluated lemma states (the potential bounds and the search). -/
abbrev OK := okN rl 5 130 61 10 16 30 wrecT true
/-- `k` rows more along the path `p`. -/
abbrev chd (k : Nat) (s : CS) (p : Nat) : CS := childOf 10 16 30 wrecT k s p
/-- The prefix with the path `p` of `k` rows from the start. -/
abbrev pth (k p : Nat) : CS := pathCS 10 16 30 wrecT wsT 400 k p

end

end F4
end Cert
end SuperpermLowerBounds
