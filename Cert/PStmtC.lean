import Cert.PComplete

/-! `PS.stmt_of_parts` (`LowerBounds/PSeq.lean`) with the kernel engine of `PEngine.lean` (generated by
gen_pstmt.py from that proof; only the hypotheses and the last step differ). -/

namespace SuperpermLowerBounds
namespace PS

open S (PermW WLink DoorEq)

theorem pstmt_of_psearchC {enc : List ℕ → ℕ} {crk nx wrec orb : ℕ → ℕ} {ws : ℕ} {rs : Bool}
    {bad badR keepN keepS keepJ : ℕ → ℕ → ℕ → Bool} {fuel : ℕ}
    (PE : Cert.PEnc enc crk nx wrec orb ws)
    (hs : Cert.psearchC bad badR keepN keepS keepJ rs wrec orb ws fuel [] ≠ none) :
    PStmt 7 rs bad badR keepN keepS keepJ := by
  intro L hL hne hkeep
  by_contra hcon
  have hbad : ap bad (cnt 7 rs L) = true ∨ (ap badR (cnt 7 rs L) = true ∧ Closes 7 L) := by
    by_contra h
    apply hcon
    rw [not_or] at h
    refine ⟨by simpa using h.1, fun hb hc => h.2 ⟨hb, hc⟩⟩
  cases L with
  | nil => exact hne rfl
  | cons x0 rest0 =>
    obtain ⟨kd0, Q0⟩ := x0
    have hQ0 : Q0 ≠ [] := hL.pieces_ne (kd0, Q0) List.mem_cons_self
    obtain ⟨v0, R0, rfl⟩ := List.exists_cons_of_ne_nil hQ0
    have hv0 : PermW 7 v0 := hL.words _ List.mem_cons_self v0 List.mem_cons_self
    have hL' := hL.relabel hv0
    -- the hypotheses, for the relabelled sequence
    have hkeep' : ∀ u x w, relabSeq v0 ((kd0, v0 :: R0) :: rest0) = u ++ x :: w → u ≠ [] →
        ap (keepK keepN keepS keepJ x.1) (cnt 7 rs u) = true := by
      intro u x w huw hu
      obtain ⟨u0, L2, e0, hu0, hL2⟩ := List.map_eq_append_iff.mp huw
      obtain ⟨x1, w1, e1, hx1, _⟩ := List.map_eq_cons_iff.mp hL2
      have h := hkeep u0 x1 w1 (by rw [e0, e1]) (by
        rintro rfl
        exact hu hu0.symm)
      have ec : cnt 7 rs u = cnt 7 rs u0 := by
        rw [← hu0]
        exact cnt_relab rs v0 u0
      rw [ec, ← hx1]
      exact h
    have hbad' : ap bad (cnt 7 rs (relabSeq v0 ((kd0, v0 :: R0) :: rest0))) = true ∨
        (ap badR (cnt 7 rs (relabSeq v0 ((kd0, v0 :: R0) :: rest0))) = true ∧
          Closes 7 (relabSeq v0 ((kd0, v0 :: R0) :: rest0))) := by
      rw [cnt_relab]
      rcases hbad with h | ⟨h1, h2⟩
      · exact Or.inl h
      · refine Or.inr ⟨h1, ?_⟩
        intro u hu v hv
        unfold relabSeq at hu hv
        rw [List.getLast?_map] at hu
        rw [List.head?_map] at hv
        simp only [Option.mem_def, Option.bind_eq_some_iff, Option.map_eq_some_iff] at hu hv
        obtain ⟨y, ⟨y0, hy0, rfl⟩, hyu⟩ := hu
        obtain ⟨z, ⟨z0, hz0, rfl⟩, hzv⟩ := hv
        rw [List.getLast?_map] at hyu
        rw [List.head?_map] at hzv
        simp only [Option.map_eq_some_iff] at hyu hzv
        obtain ⟨u0, hu0, rfl⟩ := hyu
        obtain ⟨w0, hw0, rfl⟩ := hzv
        exact (h2 u0 (by simp [hy0, hu0]) w0 (by simp [hz0, hw0])).map _
    have hshape : relabSeq v0 ((kd0, v0 :: R0) :: rest0) =
        (kd0, List.range' 1 7 :: R0.map (List.map (S.relab v0))) :: relabSeq v0 rest0 := by
      simp [relabSeq, S.map_relab_self hv0.1, hv0.2.1]
    rw [hshape] at hL' hkeep' hbad'
    generalize R0.map (List.map (S.relab v0)) = R1 at hL' hkeep' hbad'
    generalize relabSeq v0 rest0 = rest1 at hL' hkeep' hbad'
    have hperm : ∀ w ∈ List.range' 1 7 :: R1, PermW 7 w :=
      hL'.words (kd0, List.range' 1 7 :: R1) List.mem_cons_self
    have hcl : List.Pairwise (fun a b => ¬ a ~r b)
        ((List.range' 1 7 :: R1) ++ (rest1.map Prod.snd).flatten) := by
      have := hL'.classes
      simp only [List.map_cons, List.flatten_cons] at this
      exact this
    have hcl' := List.pairwise_append.mp hcl
    have hsz := hL'.size_le (kd0, List.range' 1 7 :: R1) List.mem_cons_self
    have hR1 : R1.length ≤ 7 - 2 := by
      simp only [List.length_cons] at hsz
      omega
    have hdoor := S.door_chain (by norm_num) _ hperm
      (hL'.doors (kd0, List.range' 1 7 :: R1) List.mem_cons_self) hcl'.1
    have hcont := PS.pcont_of_seq (by norm_num) rest1 (kd0, List.range' 1 7 :: R1) (List.range' 1 7 :: R1)
      (List.cons_ne_nil _ _) hL' hcl'.2.2
    have hne1 : ∀ y ∈ rest1, y.2 ≠ [] :=
      fun y hy => hL'.pieces_ne y (List.mem_cons_of_mem _ hy)
    have ec : (0, 1, 7 - 1 - (List.range' 1 7 :: R1).length) = (0, 1, 7 - 2 - R1.length) := by
      simp only [List.length_cons, Prod.mk.injEq, true_and]
      omega
    have hA := ruleAlong_of_prefix (k := 7) rs bad badR keepN keepS keepJ rest1
      (0, 1, 7 - 2 - R1.length)
      ((List.range' 1 7 :: R1).getLast (List.cons_ne_nil _ _)) hne1
      (by
        intro u x w huw
        have h := hkeep' ((kd0, List.range' 1 7 :: R1) :: u) x w (by rw [huw]; rfl) (by simp)
        have e2 : cnt 7 rs ((kd0, List.range' 1 7 :: R1) :: u)
            = u.foldl (stepC 7 rs) (0, 1, 7 - 1 - (List.range' 1 7 :: R1).length) := rfl
        rw [e2, ec] at h
        exact h)
      (by
        have e2 : cnt 7 rs ((kd0, List.range' 1 7 :: R1) :: rest1)
            = rest1.foldl (stepC 7 rs) (0, 1, 7 - 1 - (List.range' 1 7 :: R1).length) := rfl
        rw [e2, ec] at hbad'
        rcases hbad' with h | ⟨h1, h2⟩
        · exact Or.inl h
        · refine Or.inr ⟨h1, ?_⟩
          have hl := lastBlock_eq rest1 (kd0, List.range' 1 7 :: R1) (List.cons_ne_nil _ _) hne1
          exact h2 _ (by rw [hl]; rfl) (List.range' 1 7) (by simp))
    exact Cert.not_ruleAlong_of_psearchC PE hs R1 rest1 hR1
      hperm hdoor hcl'.1 hcont hA

end PS
end SuperpermLowerBounds
