def ringRow (k : Nat) : Nat := (ringN_0_135 k)

/-- `PS.ringBad PRtab 77`, read from the table (above it: at least 2 rows and at most 77 holes). -/
def rBad (_ r d : Nat) : Bool :=
  bif Nat.blt r 135 && Nat.ble d 77 then Nat.beq (ringRow r / 2 ^ d % 2) 1 else Nat.ble 2 r && Nat.ble d 77

/-- `PS.ringKeep Mtab PRtab 77`, read from the table (above it: never). -/
def rKeep (_ r d : Nat) : Bool :=
  bif Nat.blt r 135 && Nat.ble d 77 then Nat.beq (ringRow r / 2 ^ (78 + d) % 2) 1 else false

/-- `ringKeep` in closed form: the least target `T` is `max pr r + 1`. -/
def ringKeepF (r d : Nat) : Bool :=
  (List.range 78).any fun H => Nat.ble d H &&
    (Nat.ble (max (T5899.PRtab.getD H 0) r + 1) (T5899.Mtab.getD H 0) &&
     Nat.ble (max (T5899.PRtab.getD H 0) r + 1) (r + T5899.Mtab.getD (H - d) 0) &&
     Nat.ble (d * (max (T5899.PRtab.getD H 0) r + 1)) (r * H))

/-- The checks of the tables. -/
def ringChk (r d : Nat) : Bool :=
  (rBad 0 r d == PS.ringBad T5899.PRtab 77 0 r d) && (rKeep 0 r d == ringKeepF r d)

/-- The jumps: the row of every word. -/
def pO (i : Nat) : Bool := orbB 6 i (orbT i)

