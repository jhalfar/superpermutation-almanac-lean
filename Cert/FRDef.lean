import Cert.ChildN
import Cert.PEngine
import Cert.W
import Cert.WO
import LowerBounds.PSearch
import LowerBounds.PTables
import Cert.RingT

/-! The search of FR for the kernel (generated by plan_k.py). -/

namespace SuperpermLowerBounds
namespace Cert
namespace FR

noncomputable section

/-- The search below a prefix. -/
abbrev GS (s : CS) (L : List CS) : Res := pgoC PS.noRule rBad rKeep PS.noRule PS.noRule false wrecT orbT s.f s.t s.r s.d s.m s.M s.q s.B L
abbrev SN := psearchC PS.noRule rBad rKeep PS.noRule PS.noRule false wrecT orbT
/-- `k` rows more along the path `p`. -/
abbrev chd (k : Nat) (s : CS) (p : Nat) : CS := childOfP wrecT k s p
/-- The prefix with the path `p` of `k` rows from the start. -/
abbrev pth (k p : Nat) : CS := pathP wrecT wsT 400 k p

end

end FR
end Cert
end SuperpermLowerBounds
