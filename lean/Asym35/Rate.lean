/-!
# Exponent 35: the parameter choice and the real error bound

Addition to Jay Pantone's quantitative development (release 9ccbe66).
Generated by a script from Jay's CompletionEstimates
(parameter section), RealRate and AsymptoticTransfer: exponent 61 replaced
by 35, the coefficient 74 by 26 (so 148 by 52), `transferConstant` by
`transferConstant35`, and a `35` suffix on each declaration. The proofs are
his and depend on neither.
-/

namespace CoefficientTwoPrecision.Asym35

/-- Search indices for an admissible parameter never exceed `n`. This
justifies the finite search bound without any extraction of real roots. -/
theorem parameter_index_le_bound35 (C n k : ℕ) (hC : 1 ≤ C)
    (hk : C * (6 * k) ^ 35 ≤ n) : k ≤ n := by
  calc
    k ≤ 6 * k := by omega
    _ ≤ (6 * k) ^ 35 := Nat.le_pow (by decide : 0 < 35)
    _ ≤ C * (6 * k) ^ 35 := by
      simpa only [one_mul] using Nat.mul_le_mul_right ((6 * k) ^ 35) hC
    _ ≤ n := hk

/-- The largest multiple of six satisfying the integer size condition. -/
def largestSixParameter35 (C n : ℕ) : ℕ :=
  6 * Nat.findGreatest (fun k => C * (6 * k) ^ 35 ≤ n) n

theorem largestSixParameter_bounds35 (C n : ℕ) (hC : 1 ≤ C)
    (hn : C * 6 ^ 35 ≤ n) :
    6 ≤ largestSixParameter35 C n ∧
      6 ∣ largestSixParameter35 C n ∧
      C * largestSixParameter35 C n ^ 35 ≤ n ∧
      n < C * (largestSixParameter35 C n + 6) ^ 35 ∧
      n < C * (2 * largestSixParameter35 C n) ^ 35 := by
  let P : ℕ → Prop := fun k => C * (6 * k) ^ 35 ≤ n
  let k := Nat.findGreatest P n
  have hOne : P 1 := by simpa only [P, Nat.mul_one] using hn
  have hn1 : 1 ≤ n := parameter_index_le_bound35 C n 1 hC hOne
  have hk1 : 1 ≤ k := Nat.le_findGreatest hn1 hOne
  have hk : P k := Nat.findGreatest_spec hn1 hOne
  have hnext : ¬ P (k + 1) := by
    intro hnext
    have hnextBound : k + 1 ≤ n := parameter_index_le_bound35 C n (k + 1) hC hnext
    exact (Nat.findGreatest_is_greatest (P := P) (n := n)
      (show Nat.findGreatest P n < k + 1 by dsimp [k]; omega) hnextBound) hnext
  have hupper : n < C * (6 * k + 6) ^ 35 := by
    have hstrict : n < C * (6 * (k + 1)) ^ 35 := Nat.lt_of_not_ge hnext
    simpa only [Nat.mul_add, Nat.mul_one] using hstrict
  have hdef : largestSixParameter35 C n = 6 * k := rfl
  simp only [hdef]
  refine ⟨by omega, ⟨k, rfl⟩, hk, hupper, ?_⟩
  exact hupper.trans_le (Nat.mul_le_mul_left C
    (Nat.pow_le_pow_left (show 6 * k + 6 ≤ 2 * (6 * k) by omega) 35))

/-- The choice with the explicit constant from the source construction. -/
def parameterFor35 (n : ℕ) : ℕ := largestSixParameter35 transferConstant35 n

theorem parameterFor_bounds35 (n : ℕ) (hn : transferConstant35 * 6 ^ 35 ≤ n) :
    6 ≤ parameterFor35 n ∧ 6 ∣ parameterFor35 n ∧
      transferConstant35 * parameterFor35 n ^ 35 ≤ n ∧
      n < transferConstant35 * (parameterFor35 n + 6) ^ 35 ∧
      n < transferConstant35 * (2 * parameterFor35 n) ^ 35 := by
  exact largestSixParameter_bounds35 transferConstant35 n
    (by norm_num [transferConstant35]) hn

/-- A rational form of the inverse thirty-fifth-root estimate. The
constant on the right is absolute once `C` is fixed. -/
theorem inverse_parameter_power_bound35 (C n r : ℕ) (hr : 1 ≤ r) (hn : 1 ≤ n)
    (hupper : n ≤ C * (2 * r) ^ 35) :
    ((26 : ℚ) / (r : ℚ)) ^ 35 ≤ ((52 : ℚ) ^ 35 * (C : ℚ)) / (n : ℚ) := by
  have hnatural : 26 ^ 35 * n ≤ (52 ^ 35 * C) * r ^ 35 := by
    calc
      26 ^ 35 * n ≤ 26 ^ 35 * (C * (2 * r) ^ 35) :=
        Nat.mul_le_mul_left (26 ^ 35) hupper
      _ = (52 ^ 35 * C) * r ^ 35 := by ring
  have hrQ : (0 : ℚ) < r := by exact_mod_cast (show 0 < r by omega)
  have hnQ : (0 : ℚ) < n := by exact_mod_cast (show 0 < n by omega)
  have hcast : (26 : ℚ) ^ 35 * (n : ℚ) ≤
      ((52 : ℚ) ^ 35 * (C : ℚ)) * (r : ℚ) ^ 35 := by exact_mod_cast hnatural
  rw [div_pow]
  apply (le_div_iff₀ hnQ).2
  rw [div_mul_eq_mul_div]
  exact (div_le_iff₀ (pow_pos hrQ 35)).2 hcast

theorem parameterFor_inverse_power_bound35 (n : ℕ)
    (hn : transferConstant35 * 6 ^ 35 ≤ n) :
    ((26 : ℚ) / (parameterFor35 n : ℚ)) ^ 35 ≤
      ((52 : ℚ) ^ 35 * (transferConstant35 : ℚ)) / (n : ℚ) := by
  obtain ⟨hr, _, _, _, hupper⟩ := parameterFor_bounds35 n hn
  have hC : 1 ≤ transferConstant35 := by norm_num [transferConstant35]
  have hn1 : 1 ≤ n := parameter_index_le_bound35 transferConstant35 n 1 hC
    (by simpa only [Nat.mul_one] using hn)
  exact inverse_parameter_power_bound35 transferConstant35 n (parameterFor35 n)
    (le_trans (by decide : (1 : ℕ) ≤ 6) hr) hn1 (le_of_lt hupper)



theorem parameter_threshold_pos35 (n : ℕ)
    (hn : transferConstant35 * 6 ^ 35 ≤ n) : 0 < n := by
  have hC : 1 ≤ transferConstant35 := by norm_num [transferConstant35]
  have hn1 := parameter_index_le_bound35 transferConstant35 n 1 hC
    (by simpa only [Nat.mul_one] using hn)
  exact lt_of_lt_of_le Nat.zero_lt_one hn1

theorem parameter_inverse_real_bound35 (n : ℕ)
    (hn : transferConstant35 * 6 ^ 35 ≤ n) :
    (26 : ℝ) / (parameterFor35 n : ℝ) ≤
      52 * (transferConstant35 : ℝ) ^ (1 / 35 : ℝ) * (n : ℝ) ^ (-1 / 35 : ℝ) := by
  obtain ⟨hr, _, _, _, hupper⟩ := parameterFor_bounds35 n hn
  have hr0 : (0 : ℝ) < parameterFor35 n := by
    exact_mod_cast (lt_of_lt_of_le (by decide : (0 : ℕ) < 6) hr)
  have hn0 : (0 : ℝ) < n := by exact_mod_cast parameter_threshold_pos35 n hn
  have hC0 : (0 : ℝ) < transferConstant35 := by norm_num [transferConstant35]
  have hcast : (n : ℝ) ≤ (transferConstant35 : ℝ) * (2 * (parameterFor35 n : ℝ)) ^ 35 := by
    exact_mod_cast (le_of_lt hupper)
  have hroot := Real.rpow_le_rpow (le_of_lt hn0) hcast (by norm_num : (0 : ℝ) ≤ 1 / 35)
  have hrootPower : ((2 * (parameterFor35 n : ℝ)) ^ 35) ^ (1 / 35 : ℝ) =
      2 * (parameterFor35 n : ℝ) := by
    simpa only [one_div, Nat.cast_ofNat] using
      (Real.pow_rpow_inv_natCast (show (0 : ℝ) ≤ 2 * (parameterFor35 n : ℝ) by positivity)
        (by decide : (35 : ℕ) ≠ 0))
  rw [Real.mul_rpow (le_of_lt hC0) (by positivity), hrootPower] at hroot
  have hroot0 : (0 : ℝ) < (n : ℝ) ^ (1 / 35 : ℝ) := Real.rpow_pos_of_pos hn0 _
  have hscaled := mul_le_mul_of_nonneg_left hroot
    (div_nonneg (by norm_num : (0 : ℝ) ≤ 26) (le_of_lt hr0))
  have hscaleIdentity : ((26 : ℝ) / (parameterFor35 n : ℝ)) *
      ((transferConstant35 : ℝ) ^ (1 / 35 : ℝ) * (2 * (parameterFor35 n : ℝ))) =
      52 * (transferConstant35 : ℝ) ^ (1 / 35 : ℝ) := by
    field_simp [ne_of_gt hr0] <;> ring
  rw [hscaleIdentity] at hscaled
  calc
    (26 : ℝ) / (parameterFor35 n : ℝ) ≤
        (52 * (transferConstant35 : ℝ) ^ (1 / 35 : ℝ)) / (n : ℝ) ^ (1 / 35 : ℝ) :=
      (le_div_iff₀ hroot0).2 hscaled
    _ = 52 * (transferConstant35 : ℝ) ^ (1 / 35 : ℝ) * (n : ℝ) ^ (-1 / 35 : ℝ) := by
      rw [show (-1 / 35 : ℝ) = -(1 / 35 : ℝ) by ring,
        Real.rpow_neg (le_of_lt hn0)]
      rfl

theorem lower_error_real_bound35 (n : ℕ) (hn : 8 ≤ n) :
    (2 : ℝ) / ((n : ℝ) - 4) ≤ 4 * (n : ℝ) ^ (-1 / 35 : ℝ) := by
  have hn8 : (8 : ℝ) ≤ n := by exact_mod_cast hn
  have hn0 : (0 : ℝ) < n := by linarith only [hn8]
  have hn4 : (0 : ℝ) < (n : ℝ) - 4 := by linarith only [hn8]
  have hfirst : (2 : ℝ) / ((n : ℝ) - 4) ≤ 4 / (n : ℝ) := by
    apply (div_le_div_iff₀ hn4 hn0).2
    linarith only [hn8]
  have hpower := Real.rpow_le_rpow_of_exponent_le
    (show (1 : ℝ) ≤ n by linarith only [hn8])
    (by norm_num : (-1 : ℝ) ≤ -1 / 35)
  rw [Real.rpow_neg_one] at hpower
  calc
    (2 : ℝ) / ((n : ℝ) - 4) ≤ 4 / (n : ℝ) := hfirst
    _ = 4 * (n : ℝ)⁻¹ := by rfl
    _ ≤ 4 * (n : ℝ) ^ (-1 / 35 : ℝ) :=
      mul_le_mul_of_nonneg_left hpower (by norm_num)

noncomputable def remainderConstant35 : ℝ :=
  52 * (transferConstant35 : ℝ) ^ (1 / 35 : ℝ) + 4

theorem remainderConstant_bounds35 :
    4 ≤ remainderConstant35 ∧
      52 * (transferConstant35 : ℝ) ^ (1 / 35 : ℝ) ≤ remainderConstant35 := by
  have hp : (0 : ℝ) ≤ (transferConstant35 : ℝ) ^ (1 / 35 : ℝ) :=
    Real.rpow_nonneg (Nat.cast_nonneg _) _
  unfold remainderConstant35
  constructor <;> linarith only [hp]



open Filter Asymptotics

/-- The finite upper bound for the literal covering-word construction.
MainTheorems.original_finite_bound proves this proposition. -/
def OriginalWordFiniteBound35 : Prop :=
  ∀ r : ℕ, 6 ≤ r → 6 ∣ r → ∀ n : ℕ, transferConstant35 * r ^ 35 ≤ n →
    ∃ w : List (Fin n), SuperpermutationBounds.Covers w ∧
      r * w.length ≤ r * SuperpermutationUpperBound.F3 n +
        (2 * r + 26) * (n - 4).factorial

/-- The finite word bound gives the corresponding upper ratio for the
original shortest length. -/
theorem conditional_upper_ratio35 (hwords : OriginalWordFiniteBound35)
    (n : ℕ) (hn : transferConstant35 * 6 ^ 35 ≤ n) :
    ((ConstAsym.L n : ℚ) - SuperpermutationBounds.F3 n) /
        ((n - 4).factorial : ℚ) ≤ 2 + 26 / (parameterFor35 n : ℚ) := by
  obtain ⟨hr, hdvd, hsize, _, _⟩ := parameterFor_bounds35 n hn
  have hr0 : 0 < parameterFor35 n :=
    lt_of_lt_of_le (by decide : (0 : ℕ) < 6) hr
  obtain ⟨w, hw, hlength⟩ := hwords (parameterFor35 n) hr hdvd n hsize
  have hword := (integer_bound_iff35 n (parameterFor35 n) hr0 w).1 hlength
  have hminimum : (ConstAsym.L n : ℚ) ≤ (w.length : ℚ) := by
    exact_mod_cast ConstAsym.L_le_length hw
  have hfac : (0 : ℚ) < ((n - 4).factorial : ℚ) := by
    exact_mod_cast Nat.factorial_pos (n - 4)
  apply (div_le_iff₀ hfac).2
  linarith only [hminimum, hword]

/-- An explicit two-sided estimate, conditional only on the actual
finite-word upper theorem. The lower inequality uses the original
formalized lower bound. -/
theorem conditional_normalized_error_bound35 (hwords : OriginalWordFiniteBound35)
    (n : ℕ) (hn : transferConstant35 * 6 ^ 35 ≤ n) (hn8 : 8 ≤ n) :
    |((ConstAsym.L n : ℝ) - (SuperpermutationBounds.F3 n : ℝ)) /
        ((n - 4).factorial : ℝ) - 2| ≤
      remainderConstant35 * (n : ℝ) ^ (-1 / 35 : ℝ) := by
  have hupperQ := conditional_upper_ratio35 hwords n hn
  have hupper : ((ConstAsym.L n : ℝ) - (SuperpermutationBounds.F3 n : ℝ)) /
      ((n - 4).factorial : ℝ) ≤ 2 + 26 / (parameterFor35 n : ℝ) := by
    have hcast := (Rat.cast_le (K := ℝ)).2 hupperQ
    push_cast at hcast
    exact hcast
  have hlowerQ := ConstAsym.lower2_ratio (le_trans (by decide : 7 ≤ 8) hn8)
  have hlower : 2 - 2 / ((n : ℝ) - 4) ≤
      ((ConstAsym.L n : ℝ) - (SuperpermutationBounds.F3 n : ℝ)) /
        ((n - 4).factorial : ℝ) := by
    exact_mod_cast hlowerQ
  have hp : (0 : ℝ) ≤ (n : ℝ) ^ (-1 / 35 : ℝ) :=
    Real.rpow_nonneg (Nat.cast_nonneg _) _
  have hupperRate := parameter_inverse_real_bound35 n hn
  have hlowerRate := lower_error_real_bound35 n hn8
  have hKlower := mul_le_mul_of_nonneg_right remainderConstant_bounds35.1 hp
  have hKupper := mul_le_mul_of_nonneg_right remainderConstant_bounds35.2 hp
  apply abs_le.2
  constructor
  · linarith only [hlower, hlowerRate, hKlower]
  · linarith only [hupper, hupperRate, hKupper]

/-- Restoring the factorial gives the actual error in shortest word
length, rather than only a normalized statement. -/
theorem conditional_length_error_bound35 (hwords : OriginalWordFiniteBound35)
    (n : ℕ) (hn : transferConstant35 * 6 ^ 35 ≤ n) (hn8 : 8 ≤ n) :
    |(ConstAsym.L n : ℝ) - (SuperpermutationBounds.F3 n : ℝ) -
        2 * ((n - 4).factorial : ℝ)| ≤
      remainderConstant35 * (((n - 4).factorial : ℝ) *
        (n : ℝ) ^ (-1 / 35 : ℝ)) := by
  have hfac : (0 : ℝ) < ((n - 4).factorial : ℝ) := by
    exact_mod_cast Nat.factorial_pos (n - 4)
  have hid : (ConstAsym.L n : ℝ) - (SuperpermutationBounds.F3 n : ℝ) -
      2 * ((n - 4).factorial : ℝ) =
      ((n - 4).factorial : ℝ) *
        (((ConstAsym.L n : ℝ) - (SuperpermutationBounds.F3 n : ℝ)) /
          ((n - 4).factorial : ℝ) - 2) := by
    field_simp [ne_of_gt hfac]
  rw [hid, abs_mul, abs_of_pos hfac]
  have hscaled := mul_le_mul_of_nonneg_left
    (conditional_normalized_error_bound35 hwords n hn hn8) (le_of_lt hfac)
  calc
    ((n - 4).factorial : ℝ) *
        |((ConstAsym.L n : ℝ) - (SuperpermutationBounds.F3 n : ℝ)) /
          ((n - 4).factorial : ℝ) - 2| ≤
      ((n - 4).factorial : ℝ) *
        (remainderConstant35 * (n : ℝ) ^ (-1 / 35 : ℝ)) := hscaled
    _ = remainderConstant35 * (((n - 4).factorial : ℝ) *
        (n : ℝ) ^ (-1 / 35 : ℝ)) := by ring

/-- The precise eventual real-power bound, with an explicit absolute
constant. The finite upper construction remains an explicit premise. -/
theorem conditional_eventual_error_bound35 (hwords : OriginalWordFiniteBound35) :
    ∀ᶠ n : ℕ in atTop,
      |(ConstAsym.L n : ℝ) - (SuperpermutationBounds.F3 n : ℝ) -
          2 * ((n - 4).factorial : ℝ)| ≤
        remainderConstant35 * (((n - 4).factorial : ℝ) *
          (n : ℝ) ^ (-1 / 35 : ℝ)) := by
  apply eventually_atTop.2
  refine ⟨max (transferConstant35 * 6 ^ 35) 8, fun n hn => ?_⟩
  exact conditional_length_error_bound35 hwords n
    (le_trans (le_max_left _ _) hn) (le_trans (le_max_right _ _) hn)

/-- Conditional formal version of
`L(n) = F3(n) + 2 (n-4)! + O((n-4)! n^(-1/35))`.
The functions here use the original `L` and `F3`; the remaining hypothesis
is exactly the finite original-word existence theorem. -/
theorem conditional_asymptotic_35 (hwords : OriginalWordFiniteBound35) :
    (fun n : ℕ => (ConstAsym.L n : ℝ) - (SuperpermutationBounds.F3 n : ℝ) -
        2 * ((n - 4).factorial : ℝ)) =O[atTop]
      (fun n : ℕ => ((n - 4).factorial : ℝ) * (n : ℝ) ^ (-1 / 35 : ℝ)) := by
  apply isBigO_iff.2
  refine ⟨remainderConstant35, ?_⟩
  apply (conditional_eventual_error_bound35 hwords).mono
  intro n hn
  have hscale : (0 : ℝ) ≤ ((n - 4).factorial : ℝ) *
      (n : ℝ) ^ (-1 / 35 : ℝ) :=
    mul_nonneg (Nat.cast_nonneg _) (Real.rpow_nonneg (Nat.cast_nonneg _) _)
  simpa only [Real.norm_eq_abs, abs_of_nonneg hscale] using hn

end CoefficientTwoPrecision.Asym35
