import Asym37.Params
import Quantitative.AsymptoticTransfer

/-!
# Exponent 37: the parameter choice and the real error bound

Addition to Jay Pantone's quantitative development (release 9ccbe66).
Generated by opt/asym37/gen_rate.py from Jay's CompletionEstimates
(parameter section), RealRate and AsymptoticTransfer: exponent 61 replaced
by 37, `transferConstant` by `transferConstant37`, and a `37` suffix on each
declaration. The proofs are his and do not depend on the exponent.
-/

namespace CoefficientTwoPrecision.Asym37

/-- Search indices for an admissible parameter never exceed `n`. This
justifies the finite search bound without any extraction of real roots. -/
theorem parameter_index_le_bound37 (C n k : ℕ) (hC : 1 ≤ C)
    (hk : C * (6 * k) ^ 37 ≤ n) : k ≤ n := by
  calc
    k ≤ 6 * k := by omega
    _ ≤ (6 * k) ^ 37 := Nat.le_pow (by decide : 0 < 37)
    _ ≤ C * (6 * k) ^ 37 := by
      simpa only [one_mul] using Nat.mul_le_mul_right ((6 * k) ^ 37) hC
    _ ≤ n := hk

/-- The largest multiple of six satisfying the integer size condition. -/
def largestSixParameter37 (C n : ℕ) : ℕ :=
  6 * Nat.findGreatest (fun k => C * (6 * k) ^ 37 ≤ n) n

theorem largestSixParameter_bounds37 (C n : ℕ) (hC : 1 ≤ C)
    (hn : C * 6 ^ 37 ≤ n) :
    6 ≤ largestSixParameter37 C n ∧
      6 ∣ largestSixParameter37 C n ∧
      C * largestSixParameter37 C n ^ 37 ≤ n ∧
      n < C * (largestSixParameter37 C n + 6) ^ 37 ∧
      n < C * (2 * largestSixParameter37 C n) ^ 37 := by
  let P : ℕ → Prop := fun k => C * (6 * k) ^ 37 ≤ n
  let k := Nat.findGreatest P n
  have hOne : P 1 := by simpa only [P, Nat.mul_one] using hn
  have hn1 : 1 ≤ n := parameter_index_le_bound37 C n 1 hC hOne
  have hk1 : 1 ≤ k := Nat.le_findGreatest hn1 hOne
  have hk : P k := Nat.findGreatest_spec hn1 hOne
  have hnext : ¬ P (k + 1) := by
    intro hnext
    have hnextBound : k + 1 ≤ n := parameter_index_le_bound37 C n (k + 1) hC hnext
    exact (Nat.findGreatest_is_greatest (P := P) (n := n)
      (show Nat.findGreatest P n < k + 1 by dsimp [k]; omega) hnextBound) hnext
  have hupper : n < C * (6 * k + 6) ^ 37 := by
    have hstrict : n < C * (6 * (k + 1)) ^ 37 := Nat.lt_of_not_ge hnext
    simpa only [Nat.mul_add, Nat.mul_one] using hstrict
  have hdef : largestSixParameter37 C n = 6 * k := rfl
  simp only [hdef]
  refine ⟨by omega, ⟨k, rfl⟩, hk, hupper, ?_⟩
  exact hupper.trans_le (Nat.mul_le_mul_left C
    (Nat.pow_le_pow_left (show 6 * k + 6 ≤ 2 * (6 * k) by omega) 37))

/-- The choice with the explicit constant from the source construction. -/
def parameterFor37 (n : ℕ) : ℕ := largestSixParameter37 transferConstant37 n

theorem parameterFor_bounds37 (n : ℕ) (hn : transferConstant37 * 6 ^ 37 ≤ n) :
    6 ≤ parameterFor37 n ∧ 6 ∣ parameterFor37 n ∧
      transferConstant37 * parameterFor37 n ^ 37 ≤ n ∧
      n < transferConstant37 * (parameterFor37 n + 6) ^ 37 ∧
      n < transferConstant37 * (2 * parameterFor37 n) ^ 37 := by
  exact largestSixParameter_bounds37 transferConstant37 n
    (by norm_num [transferConstant37]) hn

/-- A rational form of the inverse thirty-seventh-root estimate. The
constant on the right is absolute once `C` is fixed. -/
theorem inverse_parameter_power_bound37 (C n r : ℕ) (hr : 1 ≤ r) (hn : 1 ≤ n)
    (hupper : n ≤ C * (2 * r) ^ 37) :
    ((74 : ℚ) / (r : ℚ)) ^ 37 ≤ ((148 : ℚ) ^ 37 * (C : ℚ)) / (n : ℚ) := by
  have hnatural : 74 ^ 37 * n ≤ (148 ^ 37 * C) * r ^ 37 := by
    calc
      74 ^ 37 * n ≤ 74 ^ 37 * (C * (2 * r) ^ 37) :=
        Nat.mul_le_mul_left (74 ^ 37) hupper
      _ = (148 ^ 37 * C) * r ^ 37 := by ring
  have hrQ : (0 : ℚ) < r := by exact_mod_cast (show 0 < r by omega)
  have hnQ : (0 : ℚ) < n := by exact_mod_cast (show 0 < n by omega)
  have hcast : (74 : ℚ) ^ 37 * (n : ℚ) ≤
      ((148 : ℚ) ^ 37 * (C : ℚ)) * (r : ℚ) ^ 37 := by exact_mod_cast hnatural
  rw [div_pow]
  apply (le_div_iff₀ hnQ).2
  rw [div_mul_eq_mul_div]
  exact (div_le_iff₀ (pow_pos hrQ 37)).2 hcast

theorem parameterFor_inverse_power_bound37 (n : ℕ)
    (hn : transferConstant37 * 6 ^ 37 ≤ n) :
    ((74 : ℚ) / (parameterFor37 n : ℚ)) ^ 37 ≤
      ((148 : ℚ) ^ 37 * (transferConstant37 : ℚ)) / (n : ℚ) := by
  obtain ⟨hr, _, _, _, hupper⟩ := parameterFor_bounds37 n hn
  have hC : 1 ≤ transferConstant37 := by norm_num [transferConstant37]
  have hn1 : 1 ≤ n := parameter_index_le_bound37 transferConstant37 n 1 hC
    (by simpa only [Nat.mul_one] using hn)
  exact inverse_parameter_power_bound37 transferConstant37 n (parameterFor37 n)
    (le_trans (by decide : (1 : ℕ) ≤ 6) hr) hn1 (le_of_lt hupper)



theorem parameter_threshold_pos37 (n : ℕ)
    (hn : transferConstant37 * 6 ^ 37 ≤ n) : 0 < n := by
  have hC : 1 ≤ transferConstant37 := by norm_num [transferConstant37]
  have hn1 := parameter_index_le_bound37 transferConstant37 n 1 hC
    (by simpa only [Nat.mul_one] using hn)
  exact lt_of_lt_of_le Nat.zero_lt_one hn1

theorem parameter_inverse_real_bound37 (n : ℕ)
    (hn : transferConstant37 * 6 ^ 37 ≤ n) :
    (74 : ℝ) / (parameterFor37 n : ℝ) ≤
      148 * (transferConstant37 : ℝ) ^ (1 / 37 : ℝ) * (n : ℝ) ^ (-1 / 37 : ℝ) := by
  obtain ⟨hr, _, _, _, hupper⟩ := parameterFor_bounds37 n hn
  have hr0 : (0 : ℝ) < parameterFor37 n := by
    exact_mod_cast (lt_of_lt_of_le (by decide : (0 : ℕ) < 6) hr)
  have hn0 : (0 : ℝ) < n := by exact_mod_cast parameter_threshold_pos37 n hn
  have hC0 : (0 : ℝ) < transferConstant37 := by norm_num [transferConstant37]
  have hcast : (n : ℝ) ≤ (transferConstant37 : ℝ) * (2 * (parameterFor37 n : ℝ)) ^ 37 := by
    exact_mod_cast (le_of_lt hupper)
  have hroot := Real.rpow_le_rpow (le_of_lt hn0) hcast (by norm_num : (0 : ℝ) ≤ 1 / 37)
  have hrootPower : ((2 * (parameterFor37 n : ℝ)) ^ 37) ^ (1 / 37 : ℝ) =
      2 * (parameterFor37 n : ℝ) := by
    simpa only [one_div, Nat.cast_ofNat] using
      (Real.pow_rpow_inv_natCast (show (0 : ℝ) ≤ 2 * (parameterFor37 n : ℝ) by positivity)
        (by decide : (37 : ℕ) ≠ 0))
  rw [Real.mul_rpow (le_of_lt hC0) (by positivity), hrootPower] at hroot
  have hroot0 : (0 : ℝ) < (n : ℝ) ^ (1 / 37 : ℝ) := Real.rpow_pos_of_pos hn0 _
  have hscaled := mul_le_mul_of_nonneg_left hroot
    (div_nonneg (by norm_num : (0 : ℝ) ≤ 74) (le_of_lt hr0))
  have hscaleIdentity : ((74 : ℝ) / (parameterFor37 n : ℝ)) *
      ((transferConstant37 : ℝ) ^ (1 / 37 : ℝ) * (2 * (parameterFor37 n : ℝ))) =
      148 * (transferConstant37 : ℝ) ^ (1 / 37 : ℝ) := by
    field_simp [ne_of_gt hr0] <;> ring
  rw [hscaleIdentity] at hscaled
  calc
    (74 : ℝ) / (parameterFor37 n : ℝ) ≤
        (148 * (transferConstant37 : ℝ) ^ (1 / 37 : ℝ)) / (n : ℝ) ^ (1 / 37 : ℝ) :=
      (le_div_iff₀ hroot0).2 hscaled
    _ = 148 * (transferConstant37 : ℝ) ^ (1 / 37 : ℝ) * (n : ℝ) ^ (-1 / 37 : ℝ) := by
      rw [show (-1 / 37 : ℝ) = -(1 / 37 : ℝ) by ring,
        Real.rpow_neg (le_of_lt hn0)]
      rfl

theorem lower_error_real_bound37 (n : ℕ) (hn : 8 ≤ n) :
    (2 : ℝ) / ((n : ℝ) - 4) ≤ 4 * (n : ℝ) ^ (-1 / 37 : ℝ) := by
  have hn8 : (8 : ℝ) ≤ n := by exact_mod_cast hn
  have hn0 : (0 : ℝ) < n := by linarith only [hn8]
  have hn4 : (0 : ℝ) < (n : ℝ) - 4 := by linarith only [hn8]
  have hfirst : (2 : ℝ) / ((n : ℝ) - 4) ≤ 4 / (n : ℝ) := by
    apply (div_le_div_iff₀ hn4 hn0).2
    linarith only [hn8]
  have hpower := Real.rpow_le_rpow_of_exponent_le
    (show (1 : ℝ) ≤ n by linarith only [hn8])
    (by norm_num : (-1 : ℝ) ≤ -1 / 37)
  rw [Real.rpow_neg_one] at hpower
  calc
    (2 : ℝ) / ((n : ℝ) - 4) ≤ 4 / (n : ℝ) := hfirst
    _ = 4 * (n : ℝ)⁻¹ := by rfl
    _ ≤ 4 * (n : ℝ) ^ (-1 / 37 : ℝ) :=
      mul_le_mul_of_nonneg_left hpower (by norm_num)

noncomputable def remainderConstant37 : ℝ :=
  148 * (transferConstant37 : ℝ) ^ (1 / 37 : ℝ) + 4

theorem remainderConstant_bounds37 :
    4 ≤ remainderConstant37 ∧
      148 * (transferConstant37 : ℝ) ^ (1 / 37 : ℝ) ≤ remainderConstant37 := by
  have hp : (0 : ℝ) ≤ (transferConstant37 : ℝ) ^ (1 / 37 : ℝ) :=
    Real.rpow_nonneg (Nat.cast_nonneg _) _
  unfold remainderConstant37
  constructor <;> linarith only [hp]



open Filter Asymptotics

/-- The finite upper bound for the literal covering-word construction.
MainTheorems.original_finite_bound proves this proposition. -/
def OriginalWordFiniteBound37 : Prop :=
  ∀ r : ℕ, 6 ≤ r → 6 ∣ r → ∀ n : ℕ, transferConstant37 * r ^ 37 ≤ n →
    ∃ w : List (Fin n), SuperpermutationBounds.Covers w ∧
      r * w.length ≤ r * SuperpermutationUpperBound.F3 n +
        (2 * r + 74) * (n - 4).factorial

/-- The finite word bound gives the corresponding upper ratio for the
original shortest length. -/
theorem conditional_upper_ratio37 (hwords : OriginalWordFiniteBound37)
    (n : ℕ) (hn : transferConstant37 * 6 ^ 37 ≤ n) :
    ((ConstAsym.L n : ℚ) - SuperpermutationBounds.F3 n) /
        ((n - 4).factorial : ℚ) ≤ 2 + 74 / (parameterFor37 n : ℚ) := by
  obtain ⟨hr, hdvd, hsize, _, _⟩ := parameterFor_bounds37 n hn
  have hr0 : 0 < parameterFor37 n :=
    lt_of_lt_of_le (by decide : (0 : ℕ) < 6) hr
  obtain ⟨w, hw, hlength⟩ := hwords (parameterFor37 n) hr hdvd n hsize
  have hword := (integer_bound_iff n (parameterFor37 n) hr0 w).1 hlength
  have hminimum : (ConstAsym.L n : ℚ) ≤ (w.length : ℚ) := by
    exact_mod_cast ConstAsym.L_le_length hw
  have hfac : (0 : ℚ) < ((n - 4).factorial : ℚ) := by
    exact_mod_cast Nat.factorial_pos (n - 4)
  apply (div_le_iff₀ hfac).2
  linarith only [hminimum, hword]

/-- An explicit two-sided estimate, conditional only on the actual
finite-word upper theorem. The lower inequality uses the original
formalized lower bound. -/
theorem conditional_normalized_error_bound37 (hwords : OriginalWordFiniteBound37)
    (n : ℕ) (hn : transferConstant37 * 6 ^ 37 ≤ n) (hn8 : 8 ≤ n) :
    |((ConstAsym.L n : ℝ) - (SuperpermutationBounds.F3 n : ℝ)) /
        ((n - 4).factorial : ℝ) - 2| ≤
      remainderConstant37 * (n : ℝ) ^ (-1 / 37 : ℝ) := by
  have hupperQ := conditional_upper_ratio37 hwords n hn
  have hupper : ((ConstAsym.L n : ℝ) - (SuperpermutationBounds.F3 n : ℝ)) /
      ((n - 4).factorial : ℝ) ≤ 2 + 74 / (parameterFor37 n : ℝ) := by
    have hcast := (Rat.cast_le (K := ℝ)).2 hupperQ
    push_cast at hcast
    exact hcast
  have hlowerQ := ConstAsym.lower2_ratio (le_trans (by decide : 7 ≤ 8) hn8)
  have hlower : 2 - 2 / ((n : ℝ) - 4) ≤
      ((ConstAsym.L n : ℝ) - (SuperpermutationBounds.F3 n : ℝ)) /
        ((n - 4).factorial : ℝ) := by
    exact_mod_cast hlowerQ
  have hp : (0 : ℝ) ≤ (n : ℝ) ^ (-1 / 37 : ℝ) :=
    Real.rpow_nonneg (Nat.cast_nonneg _) _
  have hupperRate := parameter_inverse_real_bound37 n hn
  have hlowerRate := lower_error_real_bound37 n hn8
  have hKlower := mul_le_mul_of_nonneg_right remainderConstant_bounds37.1 hp
  have hKupper := mul_le_mul_of_nonneg_right remainderConstant_bounds37.2 hp
  apply abs_le.2
  constructor
  · linarith only [hlower, hlowerRate, hKlower]
  · linarith only [hupper, hupperRate, hKupper]

/-- Restoring the factorial gives the actual error in shortest word
length, rather than only a normalized statement. -/
theorem conditional_length_error_bound37 (hwords : OriginalWordFiniteBound37)
    (n : ℕ) (hn : transferConstant37 * 6 ^ 37 ≤ n) (hn8 : 8 ≤ n) :
    |(ConstAsym.L n : ℝ) - (SuperpermutationBounds.F3 n : ℝ) -
        2 * ((n - 4).factorial : ℝ)| ≤
      remainderConstant37 * (((n - 4).factorial : ℝ) *
        (n : ℝ) ^ (-1 / 37 : ℝ)) := by
  have hfac : (0 : ℝ) < ((n - 4).factorial : ℝ) := by
    exact_mod_cast Nat.factorial_pos (n - 4)
  have hid : (ConstAsym.L n : ℝ) - (SuperpermutationBounds.F3 n : ℝ) -
      2 * ((n - 4).factorial : ℝ) =
      ((n - 4).factorial : ℝ) *
        (((ConstAsym.L n : ℝ) - (SuperpermutationBounds.F3 n : ℝ)) /
          ((n - 4).factorial : ℝ) - 2) := by
    field_simp [ne_of_gt hfac]
  rw [hid, abs_mul, abs_of_pos hfac]
  have hscaled := mul_le_mul_of_nonneg_left
    (conditional_normalized_error_bound37 hwords n hn hn8) (le_of_lt hfac)
  calc
    ((n - 4).factorial : ℝ) *
        |((ConstAsym.L n : ℝ) - (SuperpermutationBounds.F3 n : ℝ)) /
          ((n - 4).factorial : ℝ) - 2| ≤
      ((n - 4).factorial : ℝ) *
        (remainderConstant37 * (n : ℝ) ^ (-1 / 37 : ℝ)) := hscaled
    _ = remainderConstant37 * (((n - 4).factorial : ℝ) *
        (n : ℝ) ^ (-1 / 37 : ℝ)) := by ring

/-- The precise eventual real-power bound, with an explicit absolute
constant. The finite upper construction remains an explicit premise. -/
theorem conditional_eventual_error_bound37 (hwords : OriginalWordFiniteBound37) :
    ∀ᶠ n : ℕ in atTop,
      |(ConstAsym.L n : ℝ) - (SuperpermutationBounds.F3 n : ℝ) -
          2 * ((n - 4).factorial : ℝ)| ≤
        remainderConstant37 * (((n - 4).factorial : ℝ) *
          (n : ℝ) ^ (-1 / 37 : ℝ)) := by
  apply eventually_atTop.2
  refine ⟨max (transferConstant37 * 6 ^ 37) 8, fun n hn => ?_⟩
  exact conditional_length_error_bound37 hwords n
    (le_trans (le_max_left _ _) hn) (le_trans (le_max_right _ _) hn)

/-- Conditional formal version of
`L(n) = F3(n) + 2 (n-4)! + O((n-4)! n^(-1/37))`.
The functions here use the original `L` and `F3`; the remaining hypothesis
is exactly the finite original-word existence theorem. -/
theorem conditional_asymptotic_37 (hwords : OriginalWordFiniteBound37) :
    (fun n : ℕ => (ConstAsym.L n : ℝ) - (SuperpermutationBounds.F3 n : ℝ) -
        2 * ((n - 4).factorial : ℝ)) =O[atTop]
      (fun n : ℕ => ((n - 4).factorial : ℝ) * (n : ℝ) ^ (-1 / 37 : ℝ)) := by
  apply isBigO_iff.2
  refine ⟨remainderConstant37, ?_⟩
  apply (conditional_eventual_error_bound37 hwords).mono
  intro n hn
  have hscale : (0 : ℝ) ≤ ((n - 4).factorial : ℝ) *
      (n : ℝ) ^ (-1 / 37 : ℝ) :=
    mul_nonneg (Nat.cast_nonneg _) (Real.rpow_nonneg (Nat.cast_nonneg _) _)
  simpa only [Real.norm_eq_abs, abs_of_nonneg hscale] using hn

end CoefficientTwoPrecision.Asym37
